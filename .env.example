# Токен от @BotFather (обязательно)
BOT_TOKEN=123456789:AA...

# Кому разрешено пользоваться ботом (ID через запятую). Пусто — всем.
# Посторонним бот не отвечает вообще, без каких-либо сообщений.
# Свой ID можно узнать командой /id — она работает всегда.
# Для анонимных админов в группах добавьте ID группы (отрицательный) —
# его показывает /id, отправленный от имени группы.
ALLOWED_USERS=

# Пути к бинарникам. В Docker-образе они уже в PATH, менять не нужно.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=

# Каталог временных файлов. По умолчанию — системный tmp.
# В Docker всегда используется /data (задан в образе и compose).
# WORK_DIR=./data

# Часовой пояс для времени в логах (нужен tzdata; в образе он есть)
TZ=UTC

# Сколько видео качать одновременно и таймаут одной загрузки
CONCURRENCY=2
JOB_TIMEOUT_MIN=20

# Лимит отправляемого файла, МБ. Обычный Bot API — 50, локальный — до 2000.
MAX_UPLOAD_MB=50

# Максимальная высота видео: 1080, 720, ... или 0 — лучшее доступное качество
MAX_HEIGHT=1080

# Локальный Bot API (см. README): http://127.0.0.1:8081
# TELEGRAM_API_BASE=https://api.telegram.org
# LOCAL_BOT_API=0

# cookies.txt для YouTube/Instagram, где нужен вход.
# В Docker положите файл рядом и раскомментируйте volume в docker-compose.yml,
# затем укажите COOKIES_FILE=/data/cookies.txt
# COOKIES_FILE=./cookies.txt

# Прокси для yt-dlp, например socks5://127.0.0.1:1080
# YTDLP_PROXY=
